# Server-side only. Copy to .env.local and fill in. Never commit .env.local.
# AI_PROVIDER: currently "anthropic".
AI_PROVIDER=anthropic
AI_API_KEY=
# A model id (e.g. claude-opus-5-5) or a shorthand: opus | sonnet | haiku. Defaults to claude-opus-5-5.
AI_MODEL=claude-opus-5-5

# Abuse and spending protection (optional; these are the defaults).
RATE_LIMIT_PER_MINUTE=40
RATE_LIMIT_PER_HOUR=300
AI_DAILY_CAP=3000

# The public address of the site, used for the link on share cards and in share captions.
NEXT_PUBLIC_SITE_URL=
